{
  "name": "openings-dashboard",
  "version": "0.25.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "budget": "node scripts/budget.mjs",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write src tests scripts index.html ui.html vite.config.ts playwright.config.ts eslint.config.mjs",
    "format:check": "prettier --check src tests scripts index.html ui.html vite.config.ts playwright.config.ts eslint.config.mjs",
    "lint": "eslint --max-warnings 0 src",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "playwright test --project=chromium --project=chromium-mobile",
    "test:e2e:all": "playwright test --project=webkit --project=webkit-mobile --project=chromium-performance",
    "screenshots": "node scripts/screenshots.mjs",
    "api:gen": "node scripts/api.mjs",
    "api:check": "node scripts/api.mjs --check"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@tanstack/react-query": "5.107.1",
    "lucide-react": "1.72.0",
    "openapi-fetch": "0.17.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@babel/core": "8.1.0",
    "@babel/eslint-parser": "8.0.7",
    "@playwright/test": "1.65.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "eslint": "10.15.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "prettier": "3.10.0",
    "typescript": "7.0.2",
    "vite": "8.3.8"
  }
}
