{
  "name": "openings-dashboard",
  "version": "0.23.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "budget": "node scripts/budget.mjs",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write src tests scripts index.html ui.html vite.config.ts playwright.config.ts",
    "format:check": "prettier --check src tests scripts index.html ui.html vite.config.ts playwright.config.ts",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "screenshots": "node scripts/screenshots.mjs",
    "api:gen": "node scripts/api.mjs",
    "api:check": "node scripts/api.mjs --check"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "lucide-react": "1.70.0",
    "openapi-fetch": "0.17.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "vite": "8.3.7"
  }
}
