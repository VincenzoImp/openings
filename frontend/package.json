{
  "name": "openings-dashboard",
  "version": "0.15.2",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write src tests index.html vite.config.ts playwright.config.ts",
    "format:check": "prettier --check src tests index.html vite.config.ts playwright.config.ts",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "lucide-react": "0.468.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.2.0",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "vite": "7.3.7"
  }
}
