# systemd user service, started by openings-job-search.timer. Copy both files to
# ~/.config/systemd/user/, put OPENINGS_TOKEN=<one Agent token named for this
# schedule> in ~/.config/openings/schedule.env (chmod 600), then:
#   systemctl --user daemon-reload
#   systemctl --user enable --now openings-job-search.timer
#   loginctl enable-linger "$USER"    # optional: also run while you are logged out
[Unit]
Description=Openings: run my job search

[Service]
Type=oneshot
WorkingDirectory=%h/job-search
EnvironmentFile=%h/.config/openings/schedule.env
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/job-search/schedule/run-job-search.sh
