# Telegram bot token, referenced as "$TELEGRAM_BOT_TOKEN" in settings.yaml.
# TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz

# Adzuna credentials, referenced as "$ADZUNA_APP_ID" / "$ADZUNA_APP_KEY".
# ADZUNA_APP_ID=
# ADZUNA_APP_KEY=

# The web server binds to localhost by default. Use 0.0.0.0 only on a trusted
# network and keep firewall rules tight.
# OPENINGS_WEB_BIND=127.0.0.1

# Host port for the dashboard, API and MCP endpoint.
# OPENINGS_WEB_PORT=8501

# Optional token protecting /api and the dashboard. Send it as
# "Authorization: Bearer <token>" or "X-Openings-Token: <token>".
# OPENINGS_API_TOKEN=

# MCP DNS-rebinding protection allows localhost by default. Add the host and
# origin you connect from when using /mcp from another device.
# OPENINGS_WEB_ALLOWED_HOSTS=192.168.1.10:8501
# OPENINGS_WEB_ALLOWED_ORIGINS=http://192.168.1.10:8501
