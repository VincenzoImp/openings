# Docker Compose host binding and the URL used by browsers/external agents.
OPENINGS_BIND=127.0.0.1
OPENINGS_PORT=8080
OPENINGS_PUBLIC_URL=http://127.0.0.1:8080

# Optional first-run owner password (at least 10 characters).
# Leave empty to set it in the local dashboard. Later changes here do not reset it.
OPENINGS_PASSWORD=

# Optional local scorer profile. Set a random key, then enter the SAME value
# in Dashboard > Settings > Scoring > API key. Never commit the resulting .env.
SCORER_API_KEY=

# Maximum raw SQLite restore upload; document files have a separate 20 MiB limit.
OPENINGS_MAX_RESTORE_MB=512

# Optional existing images; the normal installation builds from this checkout.
# OPENINGS_IMAGE=ghcr.io/vincenzoimp/openings:0.5.0
# OPENINGS_SCORER_IMAGE=ghcr.io/vincenzoimp/openings-scorer:0.5.0
