# Docker Compose host binding and the URL used by browsers/external agents.
OPENINGS_BIND=127.0.0.1
OPENINGS_PORT=8080
OPENINGS_PUBLIC_URL=http://127.0.0.1:8080

# Optional first-run owner password (at least 10 characters).
# Leave empty to set it in the local dashboard. Later changes here do not reset it.
OPENINGS_PASSWORD=

# Reverse-proxy IPs/CIDRs allowed to set X-Forwarded-For/-Proto. Empty trusts none.
# OPENINGS_TRUSTED_PROXIES=172.18.0.2

# Maximum raw SQLite restore upload; document files have a separate 20 MiB limit.
OPENINGS_MAX_RESTORE_MB=2048

# At start the database file is rewritten without free space when at least a
# quarter of it and this many MiB are free. A very large value disables it.
OPENINGS_COMPACT_MIN_MB=32

# Published images are used by default. Override for private mirrors or local builds.
# OPENINGS_IMAGE=docker.io/vincenzoimp/openings:0.17.0
